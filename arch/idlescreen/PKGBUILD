# shellcheck shell=bash
# Maintainer: IdleScreen <jerydleuck@gmail.com>
# SPDX-License-Identifier: Apache-2.0
#
# makepkg supplies $srcdir, $pkgdir, $startdir and $BUILDDIR.
# shellcheck disable=SC2154,SC2178
#
# PKGBUILD for IdleScreen on Arch Linux and derivatives.
pkgbase=idlescreen
pkgname=('idlescreen')
pkgver=4.4.0
pkgrel=1
pkgdesc="Unified Wayland idle host and 50 built-in 16-bit arcade screensaver scenes"
arch=('x86_64')
url="https://idlescreen.github.io"
license=('Apache-2.0')
options=('!lto')

_idlescreen_ref="v${pkgver}"

source=(
    "idlescreen::git+https://github.com/idlescreen/idlescreen#tag=$_idlescreen_ref"
)
sha256sums=('SKIP')

makedepends=(
    'git'
    'rust'
    'pkgconf'
    'dbus'
    'wayland'
    'libxkbcommon'
)

depends=(
    'glibc'
    'dbus'
)

optdepends=(
    'idle-cosmic: COSMIC panel applet'
)

prepare() {
    cd "$srcdir/idlescreen" || return 1
    rm -f .cargo/config.toml 2>/dev/null || true
    cargo fetch --locked
}

build() {
    CFLAGS="${CFLAGS//-flto=auto/}"
    CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    LDFLAGS="${LDFLAGS//-flto=auto/}"
    export CFLAGS CXXFLAGS LDFLAGS

    export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="gcc"
    cd "$srcdir/idlescreen" || return 1
    cargo build --release --workspace
}

package_idlescreen() {
    pkgname=idlescreen
    pkgdesc="IdleScreen Wayland daemon, CLI, TUI, and 50 built-in 16-bit arcade scenes"
    install=idlescreen.install
    provides=('idle-daemon' 'idle-cli' 'idle-tui' 'idle-saver-ascii' 'idle-savers' 'idlescreen-extras')
    replaces=('idle-daemon' 'idle-cli' 'idle-tui' 'idle-saver-ascii' 'idle-savers' 'idlescreen-extras')
    conflicts=('idle-daemon' 'idle-cli' 'idle-tui' 'idle-saver-ascii' 'idle-savers' 'idlescreen-extras')
    depends=("${depends[@]}")

    install -Dm755 "$srcdir/idlescreen/target/release/idlescreen" \
        "$pkgdir/usr/bin/idlescreen"
    ln -sf idlescreen "$pkgdir/usr/bin/idle-daemon"
    ln -sf idlescreen "$pkgdir/usr/bin/idle-cli"
    ln -sf idlescreen "$pkgdir/usr/bin/idle-tui"
    install -Dm644 "$srcdir/idlescreen/assets/idlescreen.service" \
        "$pkgdir/usr/lib/systemd/user/idlescreen.service"
    install -Dm644 "$srcdir/idlescreen/assets/idlescreen.desktop" \
        "$pkgdir/etc/xdg/autostart/idlescreen.desktop"
    install -Dm644 "$srcdir/idlescreen/assets/idlescreen.1" \
        "$pkgdir/usr/share/man/man1/idlescreen.1"
    install -Dm644 "$srcdir/idlescreen/assets/io.github.idlescreen.Idle.service" \
        "$pkgdir/usr/share/dbus-1/services/io.github.idlescreen.Idle.service"
    install -Dm755 "$srcdir/idlescreen/libexec/remove-product-stack.sh" \
        "$pkgdir/usr/libexec/idlescreen/remove-product-stack"
    install -Dm755 "$srcdir/idlescreen/libexec/schedule-remove-stack.sh" \
        "$pkgdir/usr/libexec/idlescreen/schedule-remove-stack"
    install -Dm755 "$startdir/omarchy-launch-screensaver" \
        "$pkgdir/usr/local/bin/omarchy-launch-screensaver"
}