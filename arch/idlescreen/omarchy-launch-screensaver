#!/bin/sh
# Intercept the session shell's screensaver launch and hand off to IdleScreen.
#
# The shell invokes a command named `omarchy-launch-screensaver` when its idle
# timer fires. Installing this script under the same name earlier in PATH
# redirects that trigger to IdleScreen. The shell keeps ownership of idle
# timing and of screen lock; this script only draws.
#
# Exit status is the command's own: non-zero when the handoff fails, so the
# caller's log shows why nothing was presented.

set -eu

# The shell's own toggle must keep working, or `omarchy toggle screensaver`
# becomes a lie. `force` is the shell's own bypass and wins over the toggle.
if [ "${1:-}" != "force" ] \
    && omarchy-toggle-enabled screensaver-off >/dev/null 2>&1; then
    exit 0
fi

# Lock already owns the screen; never draw underneath it.
if [ "$(omarchy-shell lock isLocked 2>/dev/null || echo false)" = "true" ]; then
    exit 0
fi

# Idempotent: exit 0 if already presenting (`active:true` or legacy `presentation_active:true`).
_status_json="$(idlescreen status --json 2>/dev/null || true)"
if printf '%s' "$_status_json" | grep -q -E '"(presentation_)?active"[[:space:]]*:[[:space:]]*true'; then
    exit 0
fi

# Respect media/session inhibitors. The shell's own idle monitor honours only
# idle-inhibit-unstable-v1, so portal-derived inhibitors reach IdleScreen alone.
# `force` wins over inhibitors when the user explicitly forces the screensaver.
if [ "${1:-}" != "force" ]; then
    if printf '%s' "$_status_json" | grep -q -E '"inhibited"[[:space:]]*:[[:space:]]*true'; then
        exit 0
    fi
    if idlescreen inhibitors --json 2>/dev/null | grep -q -E '"inhibited"[[:space:]]*:[[:space:]]*true'; then
        exit 0
    fi
fi

exec idlescreen start